# Copy to .env.local (git-ignored) for local dev; set the same values as EAS env vars for builds.
# Base44 → your new SFRMR v2 app → Settings
EXPO_PUBLIC_BASE44_APP_ID=
# The app's public URL, e.g. https://sfrmr-v2.base44.app (used for Sign in with Apple)
EXPO_PUBLIC_BASE44_APP_URL=
# RevenueCat → Project → API keys → Apple public SDK key (starts with appl_)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
